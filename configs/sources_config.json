{
  "sources": {
    "EHR": {
      "table": "raw_ehr_patients",
      "id_column": "patient_id",
      "name": {
        "mode": "split",
        "first": "first_name",
        "middle": "middle_name",
        "last": "last_name"
      },
      "dob": {
        "column": "dob",
        "format": "yyyy-MM-dd"
      },
      "gender": {
        "column": "sex",
        "map": {
          "M": "M",
          "F": "F",
          "O": "O"
        }
      },
      "address": {
        "mode": "split",
        "line": "address_line",
        "city": "city",
        "state": "state",
        "pincode": "pincode"
      },
      "phone": "mobile",
      "strong_ids": {
        "aadhaar": "aadhaar_no"
      },
      "updated_at": {
        "column": "last_updated",
        "format": "yyyy-MM-dd HH:mm:ss"
      }
    },
    "LIS": {
      "table": "raw_lis_patients",
      "id_column": "lab_patient_no",
      "name": {
        "mode": "last_comma_first",
        "full": "patient_name"
      },
      "dob": {
        "column": "date_of_birth",
        "format": "dd-MM-yyyy"
      },
      "gender": {
        "column": "gender",
        "map": {
          "MALE": "M",
          "FEMALE": "F",
          "OTHER": "O"
        }
      },
      "address": {
        "mode": "split",
        "line": "street",
        "city": "city",
        "state": "state",
        "pincode": "pin"
      },
      "phone": "contact_no",
      "strong_ids": {},
      "updated_at": {
        "column": "registered_on",
        "format": "yyyy-MM-dd HH:mm:ss"
      }
    },
    "RIS": {
      "table": "raw_ris_patients",
      "id_column": "ris_pid",
      "name": {
        "mode": "split",
        "first": "given_name",
        "middle": null,
        "last": "family_name"
      },
      "dob": {
        "column": "birthdate",
        "format": "dd/MM/yyyy"
      },
      "gender": {
        "column": "sex_code",
        "map": {
          "1": "M",
          "2": "F",
          "3": "O"
        }
      },
      "address": {
        "mode": "single_line",
        "line": "address_full",
        "parts": [
          "line",
          "city"
        ]
      },
      "phone": "phone",
      "strong_ids": {},
      "updated_at": {
        "column": "study_date",
        "format": "yyyy-MM-dd HH:mm:ss"
      }
    },
    "PHARMACY": {
      "table": "raw_pharmacy_customers",
      "id_column": "rx_customer_id",
      "name": {
        "mode": "first_last",
        "full": "customer_name"
      },
      "dob": {
        "column": "dob",
        "format": "yyyy-MM-dd"
      },
      "gender": {
        "column": "gender",
        "map": {
          "M": "M",
          "F": "F",
          "O": "O"
        }
      },
      "address": {
        "mode": "split",
        "line": "address",
        "city": "city",
        "state": null,
        "pincode": "zip"
      },
      "phone": "phone_number",
      "strong_ids": {
        "aadhaar": "aadhaar"
      },
      "updated_at": {
        "column": "last_dispensed",
        "format": "yyyy-MM-dd HH:mm:ss"
      }
    },
    "BILLING": {
      "table": "raw_billing_accounts",
      "id_column": "account_no",
      "name": {
        "mode": "first_last",
        "full": "payer_name"
      },
      "dob": {
        "column": "dob",
        "format": "dd.MM.yyyy"
      },
      "gender": {
        "column": "gender",
        "map": {
          "M": "M",
          "F": "F",
          "O": "O"
        }
      },
      "address": {
        "mode": "single_line",
        "line": "billing_address",
        "parts": [
          "line",
          "city",
          "state"
        ]
      },
      "phone": "phone",
      "strong_ids": {
        "aadhaar": "aadhaar_number"
      },
      "updated_at": {
        "column": "last_invoice_ts",
        "format": "yyyy-MM-dd HH:mm:ss"
      }
    }
  },
  "standardization": {
    "name_titles": [
      "DR",
      "MR",
      "MRS",
      "MS",
      "SHRI",
      "SMT",
      "SRI",
      "MASTER",
      "BABY",
      "PROF"
    ],
    "address_abbreviations": {
      "RD": "ROAD",
      "ST": "STREET",
      "NGR": "NAGAR",
      "NO": "NUMBER",
      "APT": "APARTMENT",
      "FLR": "FLOOR",
      "CRS": "CROSS",
      "BLK": "BLOCK",
      "COL": "COLONY",
      "SEC": "SECTOR"
    },
    "invalid_phones": [
      "0000000000",
      "1111111111",
      "9999999999",
      "1234567890"
    ],
    "invalid_dob_values": [
      "1900-01-01",
      "1970-01-01",
      "2000-01-01"
    ],
    "min_dob_year": 1900,
    "gender_unknown_values": [
      "U",
      "UNKNOWN",
      ""
    ]
  }
}